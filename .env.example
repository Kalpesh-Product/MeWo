# Copy to .env for local development. Real values and credentials stay out of Git.
# Server-only MongoDB settings. Do not prefix these with NEXT_PUBLIC_.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=mewo
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=15000

# Optional comma-separated browser origins for deployments behind a reverse proxy.
# Leave blank for same-origin requests only. Origins must not include a trailing slash.
MEWO_ALLOWED_ORIGINS=

# Read-only submissions API. Generate a random secret of at least 32 characters.
# Keep this key in your external project's backend, never browser JavaScript.
# Leaving it blank disables the read API (503).
MEWO_SUBMISSIONS_API_KEY=
# Optional browser CORS allowlist for the read API only. No trailing slashes.
MEWO_SUBMISSIONS_ALLOWED_ORIGINS=
